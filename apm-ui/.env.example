# Composio Setup Copilot - Environment Configuration
# Optional: Live LLM and Search providers for live research.
# If omitted, the engine uses autonomous direct documentation fetching + curated knowledge bases.

# Google Gemini API (Recommended for structured output & long context)
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=

# Anthropic API (Alternative LLM)
# ANTHROPIC_API_KEY=

# Groq API (Fast fallback LLM)
# GROQ_API_KEY=

# Tavily Search API (For live web queries)
# Get a free key at: https://tavily.com
TAVILY_API_KEY=

# Port configuration
PORT=3000

